{
  "id": "flux2-klein-t2i",
  "version": 1,
  "title": "FLUX.2 [klein] 4B — texte vers image",
  "description": "Décor fixe en 4 étapes. Nécessite les poids FLUX.2 klein au format ComfyUI (noms de fichiers à adapter si besoin).",
  "tested": false,
  "requires": {
    "models": {
      "UNETLoader.unet_name": ["flux-2-klein-4b.safetensors"],
      "CLIPLoader.clip_name": ["qwen_3_4b.safetensors"],
      "VAELoader.vae_name": ["flux2-vae.safetensors"]
    }
  },
  "params": {
    "prompt": [["4", "text"]],
    "width": [["5", "width"], ["6", "width"]],
    "height": [["5", "height"], ["6", "height"]],
    "steps": [["6", "steps"]],
    "seed": [["7", "noise_seed"]]
  },
  "output_node": "12",
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
    "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["2", 0] } },
    "5": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": 1280, "height": 720, "batch_size": 1 } },
    "6": { "class_type": "Flux2Scheduler", "inputs": { "steps": 4, "width": 1280, "height": 720 } },
    "7": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
    "8": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
    "9": { "class_type": "BasicGuider", "inputs": { "model": ["1", 0], "conditioning": ["4", 0] } },
    "10": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["7", 0], "guider": ["9", 0], "sampler": ["8", 0], "sigmas": ["6", 0], "latent_image": ["5", 0] } },
    "11": { "class_type": "VAEDecode", "inputs": { "samples": ["10", 0], "vae": ["3", 0] } },
    "12": { "class_type": "SaveImage", "inputs": { "images": ["11", 0], "filename_prefix": "videeo/bg" } }
  }
}
